<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="description" content="{{ theme.themeheadertext }}">
		<meta name="author" content="ProteusThemes">
		<link rel="icon" type="image/ico" href="images/favicon.ico">

		<title>{{ theme.themename }} WordPress Theme Documentation</title>

		<meta name="theme-color" content="#0e1326">
		<link rel="preload" href="fonts/jost-latin.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="preload" href="fonts/literata-latin.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="stylesheet" href="stylesheets/{{ assets[theme.name].css }}">
		<script>document.documentElement.classList.add("js")</script>
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		{% part "banner" %}
		<header class="site-header">
			<div class="container  site-header__bar">
				<a class="site-header__logo" href="https://www.proteusthemes.com/">
					<img src="images/logo-2x.png" alt="ProteusThemes" width="217" height="45">
				</a>
				<button class="site-header__toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
				<nav class="site-nav" id="site-nav" aria-label="ProteusThemes">
					<ul class="site-nav__list">
						<li><a href="https://www.proteusthemes.com/help/">Support</a></li>
						<li><a href="https://www.youtube.com/user/ProteusNetCompany">Video Tutorials</a></li>
						<li><a href="https://www.proteusthemes.com/themes.html">Our Themes</a></li>
						<li><a href="{{ theme.changelogUrl }}">Changelog</a></li>
					</ul>
				</nav>
			</div>

			<div class="hero">
				<div class="container  hero__inner">
					<div class="hero__copy">
						<h1 class="hero__title">{{ theme.themename }} <span class="hero__title-accent">Documentation</span></h1>
						<p class="hero__text">{{ theme.themeheadertext }}</p>
					</div>
					<div class="hero__visual">
						<div aria-hidden="true">
							<i class="hero__shape  hero__shape--stem"></i>
							<i class="hero__shape  hero__shape--bowl"></i>
							<i class="hero__shape  hero__shape--morph"></i>
							<i class="hero__shape  hero__shape--dot"></i>
							<i class="hero__shape  hero__shape--quarter"></i>
							<i class="hero__shape  hero__shape--grid"></i>
							<i class="hero__shape  hero__shape--ring"></i>
						</div>
						<img class="hero__cover" src="images/header-cover.jpg" alt="{{ theme.themename }} Cover" width="880" height="660">
					</div>
				</div>
			</div>
		</header>
		{% part "meta" %}
