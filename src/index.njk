---
pagination:
  data: themes
  size: 1
  alias: theme
permalink: "{{ theme.name }}/index.html"
eleventyExcludeFromCollections: true
---
{% part "header" %}
		<main class="container  main">
			<aside class="toc">
				{% part "sidebar" %}
			</aside>
			<article class="content" id="content" tabindex="-1">
				{% part "content" %}
			</article>
		</main>
{% part "footer" %}
